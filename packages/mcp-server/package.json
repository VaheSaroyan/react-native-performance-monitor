{
  "name": "@rnperf/mcp-server",
  "version": "0.1.3",
  "description": "MCP server for the React Native performance monitor — gives a coding agent devices, recordings, metrics and ranked findings with source locations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaheSaroyan/react-native-performance-monitor.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://vahesaroyan.github.io/react-native-performance-monitor/",
  "bugs": {
    "url": "https://github.com/VaheSaroyan/react-native-performance-monitor/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "react-native",
    "performance",
    "profiling",
    "claude"
  ],
  "type": "module",
  "bin": {
    "rnperf-mcp": "./bundle/rnperf-mcp.mjs"
  },
  "files": [
    "bundle/rnperf-mcp.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist bundle *.tsbuildinfo",
    "bundle": "npm run build && node build-bundle.mjs",
    "prepack": "npm run bundle"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@rnperf/daemon": "*",
    "@rnperf/protocol": "*",
    "esbuild": "^0.24.2",
    "zod": "^3.24.1"
  }
}
