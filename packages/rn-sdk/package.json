{
  "name": "@rnperf/sdk",
  "version": "0.1.6",
  "description": "In-app performance probe for React Native — JS FPS, stalls, heap, component renders, and UI-thread frames via CADisplayLink on iOS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaheSaroyan/react-native-performance-monitor.git",
    "directory": "packages/rn-sdk"
  },
  "homepage": "https://vahesaroyan.github.io/react-native-performance-monitor/",
  "bugs": {
    "url": "https://github.com/VaheSaroyan/react-native-performance-monitor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "ios",
    "android",
    "RNPerfSDK.podspec",
    "react-native.config.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepare": "tsc -b"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.70"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-native": {
      "optional": false
    }
  },
  "devDependencies": {
    "@rnperf/protocol": "*"
  },
  "keywords": [
    "react-native",
    "performance",
    "profiling",
    "fps",
    "memory"
  ]
}
